<li class="px-4 mb-1">
  <details class="group" <%= 'open' if open %>>
    <summary class="-ml-1 flex items-center px-2 py-1.5 cursor-pointer rounded-lg <%= open ? 'text-woot-500 bg-slate-25 font-medium' : 'text-slate-800 hover:text-woot-500 hover:bg-slate-25' %> list-none select-none transition-colors">
      <div class="flex items-center flex-1">
        <svg width="16" height="16"><use xlink:href="#icon-settings-2-line" /></svg>
        <span class="ml-2 text-sm font-medium">Settings</span>
      </div>
      <svg class="ml-auto w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="mt-1 space-y-0.5 border-l border-slate-200 ml-3 pl-2 py-1">
      <li>
        <% overview_url = super_admin_settings_url %>
        <% overview_active = current_page?(overview_url) %>
        <%= link_to overview_url, class: "flex items-center px-2.5 py-1.5 rounded-md text-sm transition-colors #{overview_active ? 'text-woot-600 bg-woot-50 font-medium' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
          <span>Overview</span>
        <% end %>
      </li>
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <% is_active = current_page?(url) %>
        <li>
          <%= link_to url, class: "flex items-center px-2.5 py-1.5 rounded-md text-sm transition-colors #{is_active ? 'text-woot-600 bg-woot-50 font-medium' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}" do %>
            <span><%= attrs['name'] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
