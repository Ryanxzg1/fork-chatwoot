<% content_for(:title) do %>
  Instance Status
<% end %>
<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>
<section class="main-content__body">
  <div class="border border-slate-100 rounded-lg overflow-hidden bg-white shadow-sm">
    <table class="w-full text-sm text-left">
      <thead class="text-xs uppercase bg-slate-25 text-slate-500 border-b border-slate-100">
        <tr>
          <th scope="col" class="px-6 py-3 font-semibold">Metric</th>
          <th scope="col" class="px-6 py-3 font-semibold">Value</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @metrics.each do |key, value| %>
          <tr class="hover:bg-slate-25 transition-colors">
            <td class="px-6 py-3.5 font-medium text-slate-700 whitespace-nowrap"><%= key %></td>
            <td class="px-6 py-3.5 text-slate-900 font-mono text-xs"><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
